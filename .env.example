# miniviki runtime configuration.
#
# Copy to .env next to this file, or to $MINIVIKI_HOME/.env, and fill in.
# The working directory is read first, then MINIVIKI_HOME. Real environment
# variables always win over both -- this file never overrides a live shell.

# Which model client to use: openai (default), echo, or script.
#   echo   -- answers with the last user message; no key, no network, no tool calls
#   script -- replays MINIVIKI_SCRIPT, pipe-separated; no key, no network
MINIVIKI_LLM=openai

MINIVIKI_LLM_BASE_URL=https://api.deepseek.com/v1
MINIVIKI_LLM_API_KEY=
MINIVIKI_LLM_MODEL=deepseek-flash

# Where contexts, memory, skills and workspaces live. Default: ~/.miniviki
# MINIVIKI_HOME=/tmp/mvhome

# Ask for approval before the exec tool runs.
# MINIVIKI_EXEC_APPROVAL=1
